# ---- optional reputation keys (all calls are server-side) ----
# Google Safe Browsing v5: non-commercial use; called only after per-scan user consent.
GSB_API_KEY=
# VirusTotal Public API: lookups only; 4/min and 500/day free-tier limits apply.
VT_API_KEY=
# URLhaus community API: requires an abuse.ch Auth-Key.
URLHAUS_AUTH_KEY=
# PhishTank: requires an app key; exact URL checks only.
PHISHTANK_APP_KEY=

# ---- optional Mailjet email delivery ----
# Keep both keys server-side in Vercel; never commit or expose them to the browser.
# MAILJET_FROM_EMAIL must be a sender address verified in Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=PhishGuard

# ---- optional browser push (no paid push vendor) ----
# Generate a VAPID key pair and set these server-side. The public key is sent
# to the browser; never expose VAPID_PRIVATE_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- scheduled jobs ----
# Generate a long random value and configure it in the deployment environment.
# Protects the weekly push-cluster job and monthly scan-summary job.
CRON_SECRET=

# ---- runtime ----
PORT=8000
# For local development, SQLite is used by default. On Vercel, configure a
# persistent Postgres connection string (for example, from Neon) as DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PHISHGUARD_DB=/absolute/path/to/phishguard.db

# ---- Google sign-in (optional until OAuth credentials are configured) ----
# Create a Google OAuth Web application client. Never commit the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# For local Docker use http://localhost:8000/auth/google/callback.
# In Vercel Production use https://phisguard-five.vercel.app/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# ---- local account authentication ----
# Set 1 only when serving over HTTPS. Keep 0 for http://localhost:8000.
AUTH_COOKIE_SECURE=0
