# ---- optional reputation keys (the app is fully functional without them) ----
# Google Safe Browsing v4: https://console.cloud.google.com/apis/credentials
GSB_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/my-apikey  (free tier: 4 req/min)
VT_API_KEY=
# urlscan.io (optional, for screenshotting live pages)
URLSCAN_API_KEY=

# ---- runtime ----
PORT=8000
# For local development, SQLite is used by default. On Vercel, configure a
# persistent Postgres connection string (for example, from Neon) as DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PHISHGUARD_DB=/absolute/path/to/phishguard.db

# ---- local account authentication ----
# Set 1 only when serving over HTTPS. Keep 0 for http://localhost:8000.
AUTH_COOKIE_SECURE=0
